<Window x:Class="StockPilotPrintAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StockPilot Print Agent"
        Height="560"
        Width="640"
        MinHeight="500"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="StockPilot Print Agent" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Lydløs udskrift af kvitteringer og labels fra WordPress / WooCommerce" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Border x:Name="StatusBadge" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#334155" CornerRadius="12" Padding="12,5">
                    <TextBlock x:Name="StatusText" Text="Ikke forbundet" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- Forbindelsesindstillinger -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="WordPress Server &amp; Agent" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="WordPress URL:" VerticalAlignment="Center" Foreground="#475569"/>
                    <TextBox x:Name="StoreUrlBox" Grid.Column="1" Height="30" Padding="6,4" VerticalContentAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="App / API Token:" VerticalAlignment="Center" Foreground="#475569"/>
                    <TextBox x:Name="ApiTokenBox" Grid.Column="1" Height="30" Padding="6,4" VerticalContentAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Stationens navn:" VerticalAlignment="Center" Foreground="#475569"/>
                    <TextBox x:Name="AgentNameBox" Grid.Column="1" Height="30" Padding="6,4" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="StartMinimizedCheck" Grid.Column="2" Content="Start i bakken" VerticalAlignment="Center" Foreground="#475569"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveConnectBtn" Content="Gem &amp; Forbind" Background="#0284C7" Foreground="White" FontWeight="Bold"
                            Padding="16,7" BorderThickness="0" Cursor="Hand" Click="SaveConnectBtn_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Fundne lokale printere -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Registrerede Windows-printere på denne PC" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                    <Button Content="Opdater printerliste" HorizontalAlignment="Right" Padding="10,3" FontSize="11" Click="RefreshPrintersBtn_Click"/>
                </Grid>
                <TextBlock x:Name="PrintersSummaryText" Text="Indlæser..." Foreground="#475569" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Aktivitetslog -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Print- og forbindelseslog" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,8"/>
                <ListBox x:Name="LogListBox" Grid.Row="1" BorderBrush="#E2E8F0" FontFamily="Consolas" FontSize="11.5"/>
            </Grid>
        </Border>
    </Grid>
</Window>