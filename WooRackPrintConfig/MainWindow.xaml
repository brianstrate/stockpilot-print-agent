<Window x:Class="WooRackPrintConfig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WooRack Print Agent — Service Konfigurator"
        Height="640"
        Width="680"
        MinHeight="560"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="WooRack Print Agent" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="VersionText" Text="v1.0.0" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                    </StackPanel>
                    <TextBlock Text="Windows Service konfiguration (kører i baggrunden uden bruger-login)" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="CheckUpdateBtn" Content="Tjek opdatering" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155"
                            Padding="10,5" FontSize="11.5" Margin="0,0,8,0" Cursor="Hand" Click="CheckUpdateBtn_Click"/>
                    <Border x:Name="StatusBadge" Background="#334155" CornerRadius="12" Padding="12,5">
                        <TextBlock x:Name="StatusText" Text="Indlæser..." Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Opdateringsbanner -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                    <TextBlock x:Name="UpdateTitleText" Text="Ny opdatering tilgængelig!" FontWeight="Bold" FontSize="13" Foreground="#1E3A8A"/>
                    <TextBlock Text="Klik på Opdater nu for at hente og installere den nyeste version." FontSize="11.5" Foreground="#1D4ED8" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="InstallUpdateBtn" Content="Opdater nu" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="14,7" BorderThickness="0" Cursor="Hand"
                        Click="InstallUpdateBtn_Click"/>
            </Grid>
        </Border>

        <!-- WordPress Server & Service styring -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="WordPress Server &amp; Windows Service" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                    <TextBlock x:Name="WinServiceStateText" Text="Service: Tjekker..." HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="WordPress URL:" VerticalAlignment="Center" Foreground="#475569"/>
                    <TextBox x:Name="StoreUrlBox" Grid.Column="1" Height="30" Padding="6,4" VerticalContentAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="App / API Token:" VerticalAlignment="Center" Foreground="#475569"/>
                    <TextBox x:Name="ApiTokenBox" Grid.Column="1" Height="30" Padding="6,4" VerticalContentAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Stationens navn:" VerticalAlignment="Center" Foreground="#475569"/>
                    <TextBox x:Name="AgentNameBox" Grid.Column="1" Height="30" Padding="6,4" VerticalContentAlignment="Center"/>
                </Grid>

                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="StartServiceBtn" Content="Start Service" Background="#16A34A" Foreground="White" FontWeight="SemiBold"
                                Padding="12,6" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" Click="StartServiceBtn_Click"/>
                        <Button x:Name="StopServiceBtn" Content="Stop Service" Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                                Padding="12,6" BorderThickness="0" Cursor="Hand" Click="StopServiceBtn_Click"/>
                    </StackPanel>

                    <Button x:Name="SaveRestartBtn" Content="Gem &amp; Genstart Service" HorizontalAlignment="Right" Background="#0284C7" Foreground="White" FontWeight="Bold"
                            Padding="16,7" BorderThickness="0" Cursor="Hand" Click="SaveRestartBtn_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Registrerede printere -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Windows-printere tilgængelige for servicen" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,6"/>
                <TextBlock x:Name="PrintersSummaryText" Text="Indlæser..." Foreground="#475569" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Live Service-log -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Live log fra Windows Service (C:\ProgramData\WooRackPrintAgent\service.log)" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,8"/>
                <ListBox x:Name="LogListBox" Grid.Row="1" BorderBrush="#E2E8F0" FontFamily="Consolas" FontSize="11.5"/>
            </Grid>
        </Border>
    </Grid>
</Window>